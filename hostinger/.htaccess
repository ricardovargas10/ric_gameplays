# Site do Ric Gameplays na Hostinger (lives.temeron.com.br)
Options -Indexes
DirectoryIndex index.html

RewriteEngine On
# página de cada jogo: /jogos/hytale abre jogo.html (o script lê o nome no endereço)
RewriteRule ^jogos/[a-z0-9-]+/?$ jogo.html [L]
# a antiga página Frequentes agora é uma seção da página Jogos
RewriteRule ^frequentes/?$ /jogos#frequentes [R=301,NE,L]
# endereços sem .html: /series abre series.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# páginas e scripts sempre frescos depois de cada atualização
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# o painel admin só existe no PC; a pasta .git do deploy não fica à mostra
RedirectMatch 302 ^/admin/?$ /
RedirectMatch 404 /\.git
RedirectMatch 404 ^/api/dados/
